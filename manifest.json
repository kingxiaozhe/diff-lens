{
  "manifest_version": 3,
  "name": "DiffLens — Private Text Compare",
  "version": "0.3.0",
  "description": "Fast, 100% private text diff. Paste or right-click two pieces of text — nothing uploaded, no account, no ads.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DiffLens — open compare tool"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ]
}
